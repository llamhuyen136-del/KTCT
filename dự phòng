        <div style="font-family:var(--font-mono);font-size:0.75rem;color:var(--red-bright);margin-bottom:6px;">TÌNH HUỐNG 1 // TÍNH TOÁN GIÁ TRỊ THẶNG DƯ</div>
        <div style="font-size:1.1rem;font-weight:700;line-height:1.5;margin-bottom:18px;color:var(--cream);">
          Theo cơ cấu, tư bản khả biến V = 20%K. Sau chu kỳ sản xuất thứ nhất, tỷ suất giá trị thặng dư đạt m' = 100%.<br><br>
          Vậy sau chu kỳ này, bạn thu về bao nhiêu giá trị thặng dư (m)? <em>(Nhập số tiền VNĐ)</em>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
          <input id="cgM" class="retro-input" style="margin:0;max-width:320px;" inputmode="numeric" placeholder="Nhập số m..." autocomplete="off">
          <button class="retro-btn primary" data-act="th1ok">XÁC NHẬN</button>
        </div>
        <div id="cgFb" class="quiz-feedback"></div>
      </div>`);
    setTimeout(() => $('cgM') &&$('cgM').focus(), 50);
    batDauGio(THOI_GIAN_PHA2, () => chamTH1(null));
  }
  function chamTH1(raw) {
    if (khoa) return; khoa = true; dungGio();
    const v = raw === null || raw.trim() === '' ? NaN : parseFloat(raw.replace(/[.\s]/g, '').replace(',', '.'));
    const dung = Math.abs(v - S.m) < 1;
    dung ? amDung() : amSai();
    S.nhatKy.push(`TH1: ${dung ? 'đúng' : 'sai/bỏ trống'} (m = ${tien(S.m)})`);
    const inp = $('cgM'); if (inp) inp.disabled = true;
    const fb = $('cgFb'); fb.classList.add('show');
    fb.innerHTML = `<strong>${dung ? '✅ CHÍNH XÁC!' : '❌ CHƯA CHÍNH XÁC'}</strong> Giá trị thặng dư thu về: <strong>m = ${tien(S.m)}</strong>
      <p style="margin:8px 0;color:var(--cream-soft)">Công thức: m' = (m / V) × 100% ⇒ m = V = 0,2 × K = ${tien(S.m)}.</p>
      <button class="retro-btn primary" style="margin-top:8px;" data-act="th" data-n="2">SANG TÌNH HUỐNG 2 ▶</button>`;
  }

  function manTH2() {
    tag('PHA 2 • TH 2/4');
    const ops = ['Dùng 80% m cho tiêu dùng xa xỉ cá nhân, giữ 20% tiết kiệm', 'Dùng 50% m mở rộng sản xuất, 50% còn lại cho tiêu dùng cá nhân', 'Chuyển hóa 100% giá trị thặng dư m thành tư bản phụ thêm (tích lũy tối đa)'];
    hien(`${thanhGio()}${hud(S.K)}
      <div>
        <div style="font-family:var(--font-mono);font-size:0.75rem;color:var(--red-bright);margin-bottom:6px;">TÌNH HUỐNG 2 // PHÂN CHIA THẶNG DƯ (m = ${tien(S.m)})</div>
        <div style="font-size:1.1rem;font-weight:700;line-height:1.5;margin-bottom:18px;color:var(--cream);">
          Trước sự cạnh tranh từ các doanh nghiệp khác, bạn quyết định sử dụng khoản thặng dư m này như thế nào?
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;">
          ${ops.map((t, k) => `<button class="quiz-opt-btn" data-act="th2" data-k="${k}"><span class="opt-letter">${'ABC'[k]}.</span><span>${t}</span></button>`).join('')}
        </div>
        <div id="cgFb" class="quiz-feedback"></div>
      </div>`);
    batDauGio(THOI_GIAN_PHA2, () => chonTH2(0, true));
  }
  function chonTH2(k, hetGio) {
    if (khoa) return; khoa = true; dungGio();
    const he = [0, 0.5, 1][k];
    S.K = S.K + he * S.m; S.Kp = S.K; S.c2 = k;
    amDung();
    document.querySelectorAll('.quiz-opt-btn').forEach((b, i) => { b.disabled = true; if (i === k) b.classList.add('correct'); });
    const fb = $('cgFb'); fb.classList.add('show');
    fb.innerHTML = `<strong>Tư bản sau chu kỳ:</strong> K' = <strong>${tien(S.K)}</strong>
      <button class="retro-btn primary" style="margin-top:10px;" data-act="th" data-n="3">SANG TÌNH HUỐNG 3 ▶</button>`;
  }

  function manTH3() {
    tag('PHA 2 • TH 3/4'); S.m2 = 0.2 * S.K;
    hien(`${thanhGio()}${hud(S.K)}
      <div>
        <div style="font-family:var(--font-mono);font-size:0.75rem;color:var(--red-bright);margin-bottom:6px;">TÌNH HUỐNG 3 // ĐỔI MỚI CÔNG NGHỆ (m₂ = ${tien(S.m2)})</div>
        <div style="font-size:1.1rem;font-weight:700;line-height:1.5;margin-bottom:18px;color:var(--cream);">
          Các đối thủ bắt đầu áp dụng tự động hóa máy móc để hạ giá thành. Bạn điều chỉnh cơ cấu đầu tư như thế nào?
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <button class="quiz-opt-btn" data-act="th3" data-k="0"><span class="opt-letter">A.</span><span>Duy trì công nghệ cũ để tiết kiệm chi phí mua máy</span></button>
          <button class="quiz-opt-btn" data-act="th3" data-k="1"><span class="opt-letter">B.</span><span>Đổi mới công nghệ: dồn 90% m₂ mua dây chuyền mới, nâng cao cấu tạo hữu cơ (c/v)</span></button>
        </div>
        <div id="cgFb" class="quiz-feedback"></div>
      </div>`);
    batDauGio(THOI_GIAN_PHA2, () => chonTH3(0, true));
  }
  function chonTH3(k, hetGio) {
    if (khoa) return; khoa = true; dungGio();
    S.c3 = k; const thuong = k === 1 ? 0.15 * S.m2 : 0;
    S.K = S.K + S.m2 + thuong; S.K2 = S.K;
    k === 1 ? amDung() : amSai();
    document.querySelectorAll('.quiz-opt-btn').forEach((b, i) => { b.disabled = true; if (i === k) b.classList.add('correct'); });
    const fb = $('cgFb'); fb.classList.add('show');
    fb.innerHTML = k === 0 
      ? `<strong>K₂ = ${tien(S.K)}</strong><p style="color:var(--red-bright);margin:6px 0;">⚠ Năng suất thấp hơn mặt bằng thị trường, hàng hóa khó tiêu thụ.</p><button class="retro-btn primary" style="margin-top:8px;" data-act="th" data-n="4">TÌNH HUỐNG CUỐI ▶</button>`
      : `<strong>K₂ = ${tien(S.K)}</strong><p style="color:#4ade80;margin:6px 0;">✅ Năng suất vượt trội, thu được giá trị thặng dư siêu ngạch (+${tien(thuong)}).</p><button class="retro-btn primary" style="margin-top:8px;" data-act="th" data-n="4">TÌNH HUỐNG CUỐI ▶</button>`;
  }

  function manTH4() {
    tag('PHA 2 • TH 4/4');
    const ops = [
      'Ép công nhân tăng giờ làm từ 8h lên 10h/ngày (tăng giá trị thặng dư tuyệt đối)',
      'Cắt giảm 100% tiêu dùng cá nhân, tập trung tối ưu hóa dây chuyền và quy trình quản trị',
      'Bán tháo máy móc và thu hẹp 50% quy mô sản xuất'
    ];
    hien(`${thanhGio()}${hud(S.K)}
      <div>
        <div style="font-family:var(--font-mono);font-size:0.75rem;color:var(--red-bright);margin-bottom:6px;">TÌNH HUỐNG 4 // KHỦNG HOẢNG KINH TẾ BÙNG PHÁT</div>
        <div style="font-size:1.1rem;font-weight:700;line-height:1.5;margin-bottom:18px;color:var(--cream);">
          🚨 Giá nguyên vật liệu tăng cao, sức mua suy giảm. Nếu không có chiến lược đúng, bạn sẽ bị giảm 40% vốn. Bạn chọn gì?
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;">
          ${ops.map((t, k) => `<button class="quiz-opt-btn" data-act="th4" data-k="${k}"><span class="opt-letter">${'ABC'[k]}.</span><span>${t}</span></button>`).join('')}
        </div>
        <div id="cgFb" class="quiz-feedback"></div>
      </div>`);
    batDauGio(THOI_GIAN_PHA2, () => chonTH4(-1));
  }
  function chonTH4(k) {
    if (khoa) return; khoa = true; dungGio();
    let he, lyDo;
    if (k < 0) { he = 0.6; lyDo = 'Không kịp ra quyết định, bạn bị tổn thất 40% vốn.'; }
    else [he, lyDo] = BANG4['ABC'[k]]['AB'[S.c3]];
    S.K = S.K2 * he;
    he >= 1 ? amDung() : amSai();
    document.querySelectorAll('.quiz-opt-btn').forEach((b, i) => { b.disabled = true; if (i === k) b.classList.add(he >= 1 ? 'correct' : 'wrong'); });
    const fb = $('cgFb'); fb.classList.add('show');
    fb.innerHTML = `<strong>Tư bản chung cuộc: ${tien(S.K)}</strong><p style="margin:8px 0;color:var(--cream-soft);">${esc(lyDo)}</p>
      <button class="retro-btn primary" style="margin-top:10px;" data-act="ketthuc">🏁 XEM BẢNG XẾP HẠNG ▶</button>`;
  }

  /* === CLOUD FIREBASE REALTIME === */
  function docBXHLocal() { try { return JSON.parse(localStorage.getItem(KHOA_BXH)) || []; } catch (e) { return []; } }

  async function docBXH() {
    try {
      const res = await fetch(FIREBASE_URL);
      const data = await res.json();
      if (!data) return docBXHLocal();
      return Object.keys(data).map(key => data[key]);
    } catch (e) {
      return docBXHLocal();
    }
  }

  async function ghiBXH(nguoiChoi) {
    try {
      await fetch(FIREBASE_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(nguoiChoi)
      });
    } catch (e) {
      try {
        const ds = docBXHLocal();
        ds.push(nguoiChoi);
        localStorage.setItem(KHOA_BXH, JSON.stringify(ds));
      } catch (err) {}
    }
  }

  /* MÀN KẾT THÚC (ĐÃ GỠ BỎ NÚT XEM KẾT LUẬN) */
  async function manKetThuc() {
    tag('HỒI KẾT'); dungGio();
    const id = Date.now();
    const nhan = S.K >= 600 * TRIEU ? '🦈 ĐẠI TƯ BẢN — THÂU TÓM TOÀN NGÀNH' : S.K >= 300 * TRIEU ? '🐟 TƯ BẢN CỠ VỪA — TRỤ VỮNG THÀNH CÔNG' : '🐠 DOANH NGHIỆP YẾU THẾ — NGUY CƠ PHÁ SẢN';
    
    hien(`<div class="cg-center">
      <h2 style="font-size:1.8rem;text-transform:uppercase;margin-bottom:8px;">Hồi Kết Cuộc Đua</h2>
      <p style="color:var(--cream-muted);">Doanh nghiệp <strong>${esc(S.ten)}</strong> hoàn tất cuộc hành trình với:</p>
      <div class="cg-big">${tien(S.K)}</div>
      <p style="font-weight:700;color:var(--cream-soft);margin-bottom:16px;">${nhan}</p>
      <div id="bxhLoading" style="font-family:var(--font-mono);color:var(--cream-soft);margin:20px 0;">
        ⏳ Đang đồng bộ bảng xếp hạng toàn server...
      </div>
      <div id="bxhContainer" style="width:100%;"></div>
      <div class="cta-row" style="justify-content:center; margin-top:20px;">
        <button class="retro-btn primary" data-act="lai">🔄 CHƠI LẠI VÁN MỚI</button>
      </div>
    </div>`);

    beep(784, .2);
    setTimeout(() => beep(988, .3), 220);

    await ghiBXH({ id, ten: S.ten, K: S.K, time: new Date().toISOString() });
    const ds = await docBXH();
    ds.sort((a, b) => b.K - a.K);
    const top = ds.slice(0, 10);
    const hang = ds.findIndex(x => x.id === id) + 1;

    const loading = $('bxhLoading');
    if (loading) loading.remove();

    const container = $('bxhContainer');
    if (container) {
      container.innerHTML = `
        <p style="margin-bottom:12px;font-family:var(--font-mono);color:var(--red-bright);font-weight:bold;">
          Vị trí của bạn: Hạng #${hang > 0 ? hang : 'N/A'} trên toàn hệ thống
        </p>
        <table class="cg-table">
          <tr><th>HẠNG</th><th>DOANH NGHIỆP</th><th>TỔNG TƯ BẢN K</th></tr>
          ${top.map((x, i) => `
            <tr class="${x.id === id ? 'me' : ''}">
              <td>#${i + 1}</td>
              <td>${esc(x.ten)}</td>
              <td>${tien(x.K)}</td>
            </tr>
          `).join('')}
        </table>
      `;
    }
  }

  function khoiTao() {
    const r = root(); if (!r) return;
    r.addEventListener('click', e => {
      const b = e.target.closest('[data-act]'); if (!b || b.disabled) return;
      const a = b.dataset.act, i = +b.dataset.i, k = +b.dataset.k, n = +b.dataset.n;
      if (a === 'batdau') {
        const ten = $('cgTen').value.trim();
        if (!ten) { $('cgTen').focus();$('cgTen').style.borderColor = 'var(--red-bright)'; return; }
        S.ten = ten; manMoPha1();
      }
      else if (a === 'cau') manCauHoi(i);
      else if (a === 'tl') traLoiPha1(i, k, dungGio());
      else if (a === 'pha2') manMoPha2();
      else if (a === 'th') [null, manTH1, manTH2, manTH3, manTH4][n]();
      else if (a === 'th1ok') chamTH1($('cgM').value);
      else if (a === 'th2') chonTH2(k, false);
      else if (a === 'th3') chonTH3(k, false);
      else if (a === 'th4') chonTH4(k);
      else if (a === 'ketthuc') manKetThuc();
      else if (a === 'lai') manThietLap();
    });
    r.addEventListener('keydown', e => {
      if (e.key !== 'Enter') return;
      if (e.target.id === 'cgTen') r.querySelector('[data-act="batdau"]').click();
      if (e.target.id === 'cgM') r.querySelector('[data-act="th1ok"]').click();
    });
    manThietLap();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', khoiTao); else khoiTao();
})();
  </script>
</body>
