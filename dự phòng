  <script>
    function switchView(n) {
      document.querySelectorAll('.view-section').forEach(s => s.classList.toggle('active', s.id === 'view-' + n));
      document.querySelectorAll('.os-nav-btn').forEach(b => {
        const matches = (b.getAttribute('onclick') || '').includes("'" + n + "'");
        b.classList.toggle('active', matches);
        if (matches && window.innerWidth <= 980) {
          b.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      });
      window.scrollTo(0, 0);

      const crtBtn = document.getElementById('crtToggleBtn');
      if (!crtBtn) return;

      // 1. Tự động TẮT khi vào [02] Flipbook hoặc [03] Game (chữ nét, không sọc quét)[cite: 1]
      if (n === 'flipbook' || n === 'game') {
        crtBtn.classList.remove('active');
        document.body.classList.remove('crt-enabled');
        if (crtBtn.firstElementChild) {
          crtBtn.firstElementChild.textContent = '📺 CRT: OFF';
        }
      } 
      // 2. Tự động BẬT LẠI khi về [01] Desktop Home[cite: 1]
      else if (n === 'home') {
        crtBtn.classList.add('active');
        document.body.classList.add('crt-enabled');
        if (crtBtn.firstElementChild) {
          crtBtn.firstElementChild.textContent = '📺 CRT: ON';
        }
      }

      // Auto focus vào iframe flipbook khi mở
      if (n === 'flipbook') {
        const f = document.getElementById('flipbookIframe');
        if (f) setTimeout(() => f.focus(), 300);
      }
    }

    function reloadFlipbook() {
      const f = document.getElementById('flipbookIframe');
      if (f) f.src = f.src;
    }

    function toggleFlipbookFullscreen() {
      const wrapper = document.getElementById('flipbookWrapper');
      const iframe = document.getElementById('flipbookIframe');
      const target = iframe || wrapper;
      if (!wrapper) return;

      const isFs = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement;

      if (isFs || wrapper.classList.contains('mobile-fullscreen-active')) {
        const exit = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;
        if (isFs && exit) {
          exit.call(document).catch(() => {});
        }
        wrapper.classList.remove('mobile-fullscreen-active');
        const exitBtn = document.getElementById('mobileExitFsBtn');
        if (exitBtn) exitBtn.remove();
        return;
      }

      const req = target.requestFullscreen || target.webkitRequestFullscreen || target.mozRequestFullScreen || target.msRequestFullscreen;
      if (req) {
        req.call(target).catch(() => kichHoatFullscreenMobile(wrapper));
      } else {
        kichHoatFullscreenMobile(wrapper);
      }
    }

    function kichHoatFullscreenMobile(wrapper) {
      wrapper.classList.add('mobile-fullscreen-active');
      if (!document.getElementById('mobileExitFsBtn')) {
        const btn = document.createElement('button');
        btn.id = 'mobileExitFsBtn';
        btn.textContent = '✕ THU NHỎ';
        btn.setAttribute('style', 'position:fixed; top:12px; right:12px; z-index:10000000; background:rgba(206,41,26,0.95); color:#fff; border:1px solid #fff; padding:8px 14px; font-weight:bold; font-family:monospace; border-radius:4px; font-size:12px; cursor:pointer;');
        btn.onclick = toggleFlipbookFullscreen;
        document.body.appendChild(btn);
      }
    }

    function toggleCRT() { 
      const b = document.getElementById('crtToggleBtn');
      const on = b.classList.toggle('active'); 
      document.body.classList.toggle('crt-enabled', on); 
      b.textContent = '📺 CRT: ' + (on ? 'ON' : 'OFF'); 
    }

    function toggleSound() { 
      const b = document.getElementById('soundToggleBtn');
      const on = b.classList.toggle('active'); 
      b.textContent = '🔊 SFX: ' + (on ? 'ON' : 'OFF'); 
    }

    const tickClock = () => {
      const clock = document.getElementById('osClock');
      if (clock) clock.textContent = new Date().toLocaleTimeString('vi-VN', { hour12: false });
    };
    tickClock(); 
    setInterval(tickClock, 1000);
  </script>

